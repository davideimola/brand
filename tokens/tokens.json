{
  "$description": "Design tokens for Davide Imola's personal brand. Format: W3C Design Tokens (DTCG). Source of truth for davideimola.dev and the Slidev theme; run `pnpm build` to regenerate dist/.",
  "color": {
    "$type": "color",
    "palette": {
      "paper": { "$value": "#F7F5F0", "$description": "Light ground" },
      "ink": { "$value": "#1C2233", "$description": "Blue-black ink: titles, tape, rules" },
      "ink-body": { "$value": "#2A3042", "$description": "Long-form body text on paper" },
      "graphite": { "$value": "#3B4152", "$description": "Secondary text on paper" },
      "slate": { "$value": "#5B6070", "$description": "Meta, captions, mono labels on paper" },
      "rule": { "$value": "#DEDCD5", "$description": "Hairlines and borders on paper" },
      "pencil": { "$value": "#94969B", "$description": "The rule on paper: ink at 45% over paper, between the hairline and the ink" },
      "white": { "$value": "#FFFFFF", "$description": "Code block surface on paper" },
      "linen": { "$value": "#EDEAE3", "$description": "Inline code on paper" },
      "akane": { "$value": "#C91F37", "$description": "Akane red: the knot and the marker, nothing else" },
      "akane-night": { "$value": "#E0475C", "$description": "Akane lifted for dark grounds" },
      "night": { "$value": "#13151C", "$description": "Dark ground" },
      "night-surface": { "$value": "#1B1E27", "$description": "Code block surface on night" },
      "night-inline": { "$value": "#262A35", "$description": "Inline code on night" },
      "night-rule": { "$value": "#2C3040", "$description": "Hairlines on night" },
      "pencil-night": { "$value": "#757475", "$description": "The rule on night: chalk at 45% over night" },
      "chalk": { "$value": "#ECE9E2", "$description": "Ink on night" },
      "chalk-body": { "$value": "#D6D3CC", "$description": "Body text on night" },
      "fog": { "$value": "#B4B2AC", "$description": "Secondary text on night" },
      "ash": { "$value": "#8E8C86", "$description": "Meta on night" },
      "code-string": { "$value": "#2F5D3A", "$description": "String literals in code on paper" },
      "code-string-night": { "$value": "#8FBF96", "$description": "String literals in code on night" }
    },
    "light": {
      "bg": { "$value": "{color.palette.paper}" },
      "fg": { "$value": "{color.palette.ink}" },
      "fg-body": { "$value": "{color.palette.ink-body}" },
      "fg-muted": { "$value": "{color.palette.graphite}" },
      "fg-subtle": { "$value": "{color.palette.slate}" },
      "border": { "$value": "{color.palette.rule}" },
      "rule": { "$value": "{color.palette.pencil}" },
      "surface": { "$value": "{color.palette.white}" },
      "surface-inline": { "$value": "{color.palette.linen}" },
      "accent": { "$value": "{color.palette.akane}" },
      "tape-bg": { "$value": "{color.palette.ink}" },
      "tape-fg": { "$value": "{color.palette.paper}" },
      "code-string": { "$value": "{color.palette.code-string}" }
    },
    "dark": {
      "bg": { "$value": "{color.palette.night}" },
      "fg": { "$value": "{color.palette.chalk}" },
      "fg-body": { "$value": "{color.palette.chalk-body}" },
      "fg-muted": { "$value": "{color.palette.fog}" },
      "fg-subtle": { "$value": "{color.palette.ash}" },
      "border": { "$value": "{color.palette.night-rule}" },
      "rule": { "$value": "{color.palette.pencil-night}" },
      "surface": { "$value": "{color.palette.night-surface}" },
      "surface-inline": { "$value": "{color.palette.night-inline}" },
      "accent": { "$value": "{color.palette.akane-night}" },
      "tape-bg": { "$value": "{color.palette.chalk}" },
      "tape-fg": { "$value": "{color.palette.night}" },
      "code-string": { "$value": "{color.palette.code-string-night}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Schibsted Grotesk", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Titles and text" },
      "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Code, meta, small labels" },
      "label": { "$value": ["Barlow Condensed", "ui-sans-serif", "sans-serif"], "$description": "Tape labels only, always uppercase" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "type": {
    "display": { "$type": "dimension", "size": { "$value": "80px" }, "line-height": { "$value": "0.98" }, "tracking": { "$value": "-0.045em" }, "$description": "Home hero, title slides" },
    "h1": { "size": { "$value": "64px" }, "line-height": { "$value": "1.02" }, "tracking": { "$value": "-0.045em" } },
    "h2": { "size": { "$value": "32px" }, "line-height": { "$value": "1.15" }, "tracking": { "$value": "-0.03em" } },
    "h3": { "size": { "$value": "24px" }, "line-height": { "$value": "1.2" }, "tracking": { "$value": "-0.025em" } },
    "lead": { "size": { "$value": "22px" }, "line-height": { "$value": "1.5" }, "tracking": { "$value": "0" } },
    "body": { "size": { "$value": "19px" }, "line-height": { "$value": "1.7" }, "tracking": { "$value": "0" } },
    "small": { "size": { "$value": "15px" }, "line-height": { "$value": "1.5" }, "tracking": { "$value": "0" } },
    "mono": { "size": { "$value": "14px" }, "line-height": { "$value": "1.6" }, "tracking": { "$value": "0" } },
    "label": { "size": { "$value": "15px" }, "line-height": { "$value": "1" }, "tracking": { "$value": "0.12em" } }
  },
  "marker": {
    "$description": "The one red gesture per page: a rough stroke under the key word, letters cut through it (skip-ink).",
    "thickness": { "$value": "0.19em", "$description": "Stroke thickness relative to the marked text" },
    "offset": { "$value": "-0.08em", "$description": "Distance of the stroke centre below the baseline box" },
    "halo": { "$value": "0.06em", "$description": "Paper-coloured halo around the glyphs so they cut the stroke" },
    "roughness": { "$value": 4, "$description": "SVG feDisplacementMap scale" },
    "frequency": { "$value": 0.7, "$description": "SVG feTurbulence baseFrequency" }
  },
  "tape": {
    "$description": "Label-maker tape for sections and content types. Ink only, never red, no emboss.",
    "radius": { "$value": "3px" },
    "padding-y": { "$value": "0.27em" },
    "padding-x": { "$value": "0.67em" },
    "tilt": { "$value": ["-1deg", "1deg", "-0.5deg"], "$description": "Cycle through these, never tilt every tape the same way" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "sm": { "$value": "3px" },
    "md": { "$value": "6px" }
  },
  "mark": {
    "$description": "Which cut of the mark to use at which rendered size (px, height).",
    "cut-l-min": { "$value": 96 },
    "cut-m-min": { "$value": 40 },
    "cut-s-max": { "$value": 39 }
  },
  "slides": {
    "$description": "Projection minimums for the Slidev theme.",
    "body-min": { "$value": "24px" },
    "code-min": { "$value": "22px" },
    "code-max-lines": { "$value": 14 }
  }
}
